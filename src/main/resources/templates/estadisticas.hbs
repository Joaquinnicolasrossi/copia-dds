{{#partial "contenido"}}
 <!--  <form action="/estadisticas/generar" method="post">
            <button type="submit" class="btn-regenerar">
                🔄 Regenerar
            </button>
    <</form>
  -->
    <div class="solicitudes-lista">
        <h1>Estadísticas Generales</h1>
        {{#if colecciones}}
            <table class="tabla-colecciones">
                <thead>
                <tr>
                    <th>Colección</th>
                    <th>Provincia con más hechos</th>
                    <th>Categoría con más hechos</th>
                    <th>Provincia con más hechos por categoria</th>
                    <th>Hora con mas hechos por categoria</th>
                    <th>Solicitudes Spam</th>
                </tr>
                </thead>
                <tbody>
                {{#each colecciones}}
                    <tr>
                        <td>{{titulo}}</td>
                        <td>
                            {{#if estadisticaProvinciaMayor}}
                                <strong>{{estadisticaProvinciaMayor.valor}}</strong>
                                ({{estadisticaProvinciaMayor.cantidad}} hechos)
                            {{else}}
                                <span>-</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if estadisticaCategoriaMayor}}
                                <strong>{{estadisticaCategoriaMayor.valor}}</strong>
                                ({{estadisticaCategoriaMayor.cantidad}} hechos)
                            {{else}}
                                <span>-</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if estadisticaProvinciaMasHechosPorCategoria}}
                                {{#each estadisticaProvinciaMasHechosPorCategoria}}
                                    <div class="estadisticas_categoria">
                                        <strong>{{@key}}:</strong>
                                        {{this.valor}}
                                        <span style="color: #666;">({{this.cantidad}} hechos)</span>
                                    </div>
                                {{/each}}
                            {{else}}
                                <span>-</span>
                        {{/if}}
                        </td>
                        <td>
                            {{#if estadisticaHoraMasHechosPorCategoria}}
                                {{#each estadisticaHoraMasHechosPorCategoria}}
                                    <div class="estadisticas_categoria">
                                        <strong>{{@key}}:</strong>
                                        {{this.valor}}
                                        <span style="color: #666;">({{this.cantidad}} hechos)</span>
                                    </div>
                                {{/each}}
                            {{else}}
                                <span>-</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if estadisticaCantidadSpam}}
                                {{estadisticaCantidadSpam.cantidad}} solicitudes
                            {{else}}
                                <span>0 solicitudes</span>
                            {{/if}}
                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        {{else}}
            <p class="sin-colec">No hay colecciones disponibles</p>
        {{/if}}
        </div>
{{/partial}}

{{>templates/layout-administrador}}